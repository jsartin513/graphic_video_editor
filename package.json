{
  "name": "video-editor",
  "version": "1.0.0",
  "description": "Mac app for merging GoPro videos",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "prebuild": "node scripts/copy-ffmpeg-binaries.js",
    "prebuild:mac": "node scripts/copy-ffmpeg-binaries.js",
    "prebuild:arm64": "TARGET_ARCH=arm64 node scripts/copy-ffmpeg-binaries.js",
    "prebuild:x64": "TARGET_ARCH=x64 node scripts/copy-ffmpeg-binaries.js",
    "build": "npm run build:fat",
    "build:mac": "electron-builder --config electron-builder.config.js --mac",
    "build:arm64": "electron-builder --config electron-builder.config.js --mac --arm64",
    "build:x64": "electron-builder --config electron-builder.config.js --mac --x64",
    "build:fat": "BUNDLE_FFMPEG=true npm run prebuild:x64 && electron-builder --config electron-builder.config.js --mac --x64 && BUNDLE_FFMPEG=true npm run prebuild:arm64 && electron-builder --config electron-builder.config.js --mac --arm64",
    "build:fat:arm64": "BUNDLE_FFMPEG=true npm run prebuild:arm64 && electron-builder --config electron-builder.config.js --mac --arm64",
    "build:fat:x64": "BUNDLE_FFMPEG=true npm run prebuild:x64 && electron-builder --config electron-builder.config.js --mac --x64",
    "build:lite": "BUNDLE_FFMPEG=false npm run prebuild && electron-builder --config electron-builder.config.js --mac --x64 --arm64",
    "build:lite:arm64": "BUNDLE_FFMPEG=false npm run build:arm64",
    "build:lite:x64": "BUNDLE_FFMPEG=false npm run build:x64",
    "dist": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "verify-build": "node scripts/verify-fat-build.js",
    "verify-signed-build": "bash scripts/verify-signed-build.sh",
    "build:signed:arm64": "bash scripts/build-signed-mac-arm64.sh",
    "check-signing": "node docs/local/check-signing-setup.js",
    "generate-icon": "node scripts/generate-icon.js && bash scripts/create-icns.sh"
  },
  "keywords": [
    "video",
    "editor",
    "gopro"
  ],
  "author": "Jessica Sartin",
  "license": "MIT",
  "dependencies": {
    "@octokit/rest": "^20.0.2",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.6.2",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "moduleNameMapper": {
      "^electron$": "<rootDir>/__mocks__/electron.js"
    },
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js",
      "!**/node_modules/**"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  }
}
